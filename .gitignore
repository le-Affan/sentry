# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# Raw corpora are large (~100 MB) and re-downloadable via `make data`.
# Never commit them; DATA_SURVEY.md records what they contained.
# Ignore the *contents*, not the directories themselves -- git will not descend
# into an ignored directory, so `data/raw/` would make the !.gitkeep rule dead.
data/raw/*
data/interim/*
data/processed/*

# Keep the directory skeleton so a fresh clone has somewhere to download into.
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Model predictions ARE tracked. Unlike the corpora, they are not regenerable
# without a GPU -- reproducing them cost ~0.9h of Kaggle quota -- and they are
# the evidence behind docs/EVAL_RESULTS.md. ~145 KB each.
!data/processed/preds_base.jsonl
!data/processed/preds_tuned.jsonl

# ---------------------------------------------------------------------------
# Model artifacts and run outputs
# ---------------------------------------------------------------------------
outputs/*
!outputs/.gitkeep
*.safetensors
*.bin
*.gguf
*.pt
*.ckpt
adapter_model/
checkpoint-*/
runs/
wandb/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store

# Clone scratch used by `make data`
.scratch/
