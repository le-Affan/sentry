# Copy to .env and fill in. .env is gitignored -- never commit real values.
#   cp .env.example .env

# Kaggle API credentials, for pushing datasets/notebooks from the CLI.
# From https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face token. Only needed if a gated model is used; Qwen2.5-3B-Instruct
# is open, so this is usually optional.
HF_TOKEN=

# Where downloaded model weights are cached (optional).
HF_HOME=

# Google Gemini API key, used by src/generate_reports.py
GEMINI_API_KEY=
